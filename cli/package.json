{
  "name": "@samuelchung/ralph-cli",
  "version": "0.1.3",
  "description": "Run Ralph planner-routed AI coding-agent loops until final success criteria pass",
  "type": "module",
  "bin": {
    "ralph": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "prepare": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "test:init": "npm run build && node --test tests/init.test.mjs",
    "token-count": "node scripts/count-context-tokens.mjs",
    "tokens": "node scripts/count-context-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "files": [
    "LICENSE",
    "dist",
    "templates"
  ],
  "keywords": [
    "ralph",
    "ai",
    "agent",
    "autonomous",
    "claude",
    "amp",
    "copilot",
    "codex",
    "prd",
    "coding-agent"
  ],
  "author": "snarktank",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samchung95/ralph-cli.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/samchung95/ralph-cli/issues"
  },
  "homepage": "https://github.com/samchung95/ralph-cli#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "gpt-tokenizer": "^3.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
